#include "libft.h"
#include <stdio.h>

int		ft_countc(const char *s, char c);
size_t	ft_strlen(const char *s);

char	**ft_split(char const *s, char c)
{
	char	*ptr;
	char	**pt2;
	int		si;
	int		pi;
	int		pi2;

	pi = 0;
	pi2 = 0;
	si = 0;
	pt2 = (char **)malloc((ft_countc(s, c) * ft_strlen(s)) + 1 * sizeof(char *));
	if (pt2 == NULL)
		return (0);
	ptr = (char *)malloc(ft_countc(s, c) + ft_strlen(s) + 1 * sizeof(char));
	if (ptr == NULL)
		return (NULL);
	while (s[si] == c)
		si++;
	while (s[si] != '\0')
	{
		if (s[si] == c)
		{
			pt2[pi2] = ptr;
			pi2++;
			while (s[si] == c)
				si++;
			pi = 0;
			ptr = (char *)malloc(ft_countc(s, c) + ft_strlen(s)
					|| + 1 * sizeof(char));
			if (ptr == NULL)
				return (0);
		}
		else
		{
			ptr[pi] = s[si];
			pi++;
			si++;
		}
	}
	pt2[pi2] = '\0';
	si = 0;
	while (pt2[si])
	{
		printf("%s\n", pt2[si]);
		si++;
	}
	return (pt2);
}

int	ft_countc(const char *s, char c)
{
	int	i;
	int	count;

	i = 1;
	while (s[i])
	{
		if (s[i] == c)
			count++;
		i++;
	}
	return (count);
}

size_t	ft_strlen(const char *s)
{
	char	count;

	count = 0;
	while (*s != '\0')
	{
		count++;
		s++;
	}
	return (count);
}

int	main(void)
{
	printf("%p", ft_split("lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed non risus. Suspendisse", ' '));
	return (0);
}
