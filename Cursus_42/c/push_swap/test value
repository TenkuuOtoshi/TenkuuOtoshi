void	ft_print(t_chain *ca1)
{
	t_chain	*tmp;

	tmp = ca1;
	if (ca1 == NULL)
		return ;
	while (tmp->prev != NULL)
		tmp = tmp->prev;
	while (tmp != NULL)
	{
		ft_printf("%d\n", tmp->n);
		tmp = tmp->next;
	}
	ft_printf("end\n");
}

int	ft_count_arg(char **argv)
{
	int	i;

	i = 0;
	while (argv[i] != NULL)
		i++;
	return (--i);
}

int	ft_check_arg(char **argv)
{
	int	i;

	i = 0;
	while (argv[1][i] != '\0')
	{
		if (argv[1][i] == ' ')
			return (1);
		i++;
	}
	return (0);
}

int	main(int argc, char **argv)
{
	int	arg;

	arg = 0;
	if (!argv[1])
	{
		ft_putstr_fd("Error\n", 2);
		return (0);
	}
	if (ft_check_arg(argv) != 0)
	{
		argv = ft_split(argv[1], ' ');
		arg = 1;
	}
	if (ft_check_double(argv) != 0)
	{
		ft_putstr_fd("Error\n", 2);
		return (0);
	}
	if (ft_check_nbr(argv) != 0)
		return (0);
	if (ft_count_arg(argv) == 2)
	{
		if (ft_atoi(argv[1]) > ft_atoi(argv[2]))
			ft_printf("sa\n");
		return (0);
	}
	else if (ft_count_arg(argv) == 3)
		ft_algo_3(argv, arg);
	else if (ft_count_arg(argv) > 3 && ft_count_arg(argv) <= 70)
		ft_algo_5(argv, arg);
	else if (ft_count_arg(argv) >= 71 && ft_count_arg(argv) <= 350)
		ft_algo_100(argv, arg);
	else if (ft_count_arg(argv) > 350)
		ft_algo_500(argv, arg);
	if (arg == 1)
		ft_free_arg(argv);
	(void)argc;
}

